[configuration]

entry_symbol = "gode_runtime_library_init"
compatibility_minimum = "4.6.2"

[icons]

TypeScript = "res://addons/godot-js/icons/typescript.svg"

[libraries]

windows.debug.x86_64 = "res://addons/godot-js/binary/windows/x64/libgode_runtime.dll"
windows.release.x86_64 = "res://addons/godot-js/binary/windows/x64/libgode_runtime.dll"

linux.debug.x86_64 = "res://addons/godot-js/binary/linux/x64/libgode_runtime.so"
linux.release.x86_64 = "res://addons/godot-js/binary/linux/x64/libgode_runtime.so"

macos.debug.arm64 = "res://addons/godot-js/binary/macos/arm64/libgode_runtime.dylib"
macos.release.arm64 = "res://addons/godot-js/binary/macos/arm64/libgode_runtime.dylib"

android.debug.arm64 = "res://addons/godot-js/binary/android/arm64/libgode_runtime.so"
android.release.arm64 = "res://addons/godot-js/binary/android/arm64/libgode_runtime.so"

ios.debug.arm64 = "res://addons/godot-js/binary/ios/arm64/libgode_runtime.dylib"
ios.release.arm64 = "res://addons/godot-js/binary/ios/arm64/libgode_runtime.dylib"


web.debug.wasm32 = "res://addons/godot-js/binary/web/wasm32/libgode_runtime.wasm"
web.release.wasm32 = "res://addons/godot-js/binary/web/wasm32/libgode_runtime.wasm"
